# ==============================================================================
# Distributed AI/ML Job Processing Platform - Configuration
# ==============================================================================

# Node.js API Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/distributed_ml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=distributed_ml
DB_POOL_MIN=2
DB_POOL_MAX=20

# Message Broker & Distributed State (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Python Services
SCHEDULER_HOST=localhost
SCHEDULER_PORT=8000
SCHEDULER_URL=http://localhost:8000
DEFAULT_SCHEDULING_POLICY=resource_aware
SCHEDULER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_TIMEOUT_SECONDS=15

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_ARTIFACTS_DIR=./storage/artifacts
STORAGE_BATCHES_DIR=./storage/batches
MAX_UPLOAD_SIZE_BYTES=104857600

# Worker Configuration
WORKER_CONCURRENCY=4
TASK_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_JITTER=true

# Predictive Scheduling Model
PREDICTION_MODEL_PATH=./ml/models/job_runtime_predictor.joblib
PREDICTION_FALLBACK_POLICY=resource_aware
MIN_TRAINING_RECORDS=5

# Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=info
STRUCTURED_JSON_LOGGING=true
